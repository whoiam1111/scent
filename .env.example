# 비워 두면 데모 모드(AI 미사용)로 동작합니다.
# 넣으면 그림 일기 '문장'을 Claude가 만듭니다. 서버 전용 — NEXT_PUBLIC_ 접두사 금지.
ANTHROPIC_API_KEY=""
# 기본값 claude-opus-5-5
AI_MODEL=""

# 코칭존 상담 결과 저장 (Supabase → Project Settings → API). 서버 전용.
# 비워 두면 개발 중에는 메모리에 저장하고, 배포 환경에서는 상담 저장을 끈다.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# 저장한 결과를 며칠 뒤 지울지 (기본 7)
HEART_RETENTION_DAYS=""
# /coach 상담사 화면 비밀번호 (Basic 인증, 아이디는 아무거나). 비우면 /coach가 닫힌다.
COACH_PASSWORD=""

# 그림 생성: OpenAI Images (gpt-image-2.5-flare, 유료, 장당 과금). 비우면 일러스트 템플릿.
# platform.openai.com → API keys 에서 발급. 서버 전용.
OPENAI_API_KEY=""

# 코칭존 신청이 저장되면 누적 양식 한 줄을 텔레그램 방으로 보낸다. 비우면 보내지 않는다.
# 토큰: 텔레그램 @BotFather → /newbot. 방 번호: 봇을 방에 초대하고 메시지를 하나 보낸 뒤
# https://api.telegram.org/bot<토큰>/getUpdates 에서 "chat":{"id": 뒤의 숫자 (단체방은 -로 시작)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 단체방에서 고쳐 올린 누적 결과지를 시다봇에서 읽어 그 뒤에 이어 붙임 (예: https://계정.alwaysdata.net/cdabot/board, 시다봇 BOARD_SECRET 과 같은 값)
CDABOT_BOARD_URL=
CDABOT_BOARD_SECRET=
